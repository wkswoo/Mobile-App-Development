.card-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 名片头部 */
.card-header {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 20rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  border: 4rpx solid #e6f7ff;
}

.user-info {
  flex: 1;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
  display: block;
}

.title {
  font-size: 28rpx;
  color: #1890ff;
  margin-bottom: 8rpx;
  display: block;
}

.company {
  font-size: 24rpx;
  color: #666666;
  display: block;
}

/* 通用区块样式 */
.contact-section,
.bio-section,
.skills-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  display: block;
}

/* 联系方式 */
.contact-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.contact-text {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
}

/* 个人简介 */
.bio-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 36rpx;
}

/* 技能标签 */
.skills-container {
  display: flex;
  flex-wrap: wrap;
}

.skill-tag {
  background-color: #e6f7ff;
  color: #1890ff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-btn {
  background-color: #1890ff;
  color: #ffffff;
  border: none;
}

.save-btn {
  background-color: #ffffff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
}

/* 点击效果 */
.contact-item {
  cursor: pointer;
}

.contact-item:active {
  background-color: #f5f5f5;
}

.action-btn:active {
  opacity: 0.8;
}