/* index.wxss */

/* 全局样式 */
page {
  background-color: #f8f8f8;
}

.container {
  padding: 16rpx;
}

/* 搜索框样式 */
.search-box {
  margin-bottom: 20rpx;
}

.search-input {
  background-color: #ffffff;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 瀑布流海报墙样式 */
.poster-wall {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.poster-list {
  width: 48%;
  margin-bottom: 20rpx;
}

/* 悬浮发布按钮 */
.floating-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #007aff;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  z-index: 999;
}