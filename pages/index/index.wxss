/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F5F5;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 顶部区域：圆形头像占位、姓名、专业年级 */
.top-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

/* 圆形头像占位 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #1A73E8;
}

/* 姓名 */
.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 专业年级 */
.major-grade {
  font-size: 28rpx;
  color: #666;
}

/* 通用区域样式 */
.contact-section,
.skills-section,
.bio-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 区域标题 */
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* 联系方式项 */
.contact-item {
  display: flex;
  margin-bottom: 15rpx;
  align-items: center;
}

.contact-label {
  font-size: 28rpx;
  color: #666;
  width: 120rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* 技能标签容器 */
.skills-container {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

/* 技能标签 */
.skill-tag {
  background-color: #E3F2FD;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #1976D2;
}

/* 简介文本 */
.bio-text {
  font-size: 28rpx;
  color: #1A73E8;
  line-height: 40rpx;
  text-align: justify;
}
