/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}


/* 打卡统计样式 */
.stats-container {
  margin: 20rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #07c160;
}

.stat-label {
  font-size: 28rpx;
  color: #666;
  margin-top: 10rpx;
}

/* 打卡表单样式 */
.form-container {
  margin: 20rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.form-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 150rpx;
  border: 1px solid #ccc;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 28rpx;
  resize: none;
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  background-color: #07c160;
  color: white;
  font-size: 32rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

/* 打卡记录样式 */
.records-container {
  margin: 20rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.records-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.no-records {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.record-item {
  padding: 15rpx;
  border: 1px solid #eee;
  border-radius: 8rpx;
  background-color: #f9f9f9;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.record-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.delete-btn {
  font-size: 24rpx;
  color: #ff4d4f;
  background: none;
  border: none;
  padding: 0;
}

.record-content,
.record-harvest {
  margin-bottom: 10rpx;
  font-size: 26rpx;
}

.content-label {
  color: #666;
  margin-right: 10rpx;
}

.content-text {
  color: #333;
  word-break: break-all;
}
