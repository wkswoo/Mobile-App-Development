<!--index.wxml-->
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 基本信息 -->
    <view class="card">
      <view class="card-title">基本信息</view>
      <view class="info-item">
        <text class="info-label">姓名：</text>
        <text class="info-value">{{name}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">年级：</text>
        <text class="info-value">{{grade}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">学院：</text>
        <text class="info-value">{{college}}</text>
      </view>
    </view>
    
    <!-- 联系方式 -->
    <view class="card">
      <view class="card-title">联系方式</view>
      <view wx:for="{{contacts}}" wx:key="type" class="info-item">
        <text class="info-label">{{item.label}}：</text>
        <text class="info-value">{{item.value}}</text>
      </view>
    </view>
    
    <!-- 个人技能 -->
    <view class="card">
      <view class="card-title">个人技能</view>
      <view class="skills-container">
        <view wx:for="{{skills}}" wx:key="index" class="skill-tag">
          {{item}}
        </view>
      </view>
    </view>
    
    <!-- 个人成就 -->
    <view class="card">
      <view class="card-title">个人成就</view>
      <view wx:for="{{achievements}}" wx:key="index" class="achievement-item">
        <text class="achievement-text">{{item}}</text>
      </view>
    </view>
    
    <!-- 个人简介 -->
    <view class="card">
      <view class="card-title">个人简介</view>
      <text class="bio-text">{{bio}}</text>
    </view>
  </view>
</scroll-view>
