<!--index.wxml-->
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 搜索框 -->
    <view class="search-box">
      <input 
        class="search-input" 
        placeholder="搜索活动名称" 
        bindinput="onSearchInput"
        value="{{searchText}}"
      />
    </view>
    
    <!-- 瀑布流海报墙 -->
    <view class="poster-wall">
      <view class="poster-list" wx:for="{{filteredPosters}}" wx:key="id">
        <poster-card 
          poster="{{item}}" 
          index="{{index}}" 
          bind:preview="previewImage"
        />
      </view>
    </view>
    
    <!-- 悬浮发布按钮 -->
    <view class="floating-btn" bindtap="navigateToPublish">
      <text>+</text>
    </view>
  </view>
</scroll-view>