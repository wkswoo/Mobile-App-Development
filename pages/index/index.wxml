<!--index.wxml-->
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 搜索框 -->
    <view class="search-box">
      <input 
        class="search-input" 
        placeholder="搜索活动名称" 
        bindinput="onSearchInput"
        value="{{searchText}}"
      />
    </view>
    
    <!-- 瀑布流海报墙 -->
    <view class="poster-wall">
      <view class="poster-list" wx:for="{{filteredPosters}}" wx:key="id">
        <view class="poster-card">
          <image class="poster-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="poster-content">
            <text class="poster-title">{{item.title}}</text>
            <view class="poster-info">
              <text class="poster-date">{{item.date}}</text>
              <text class="poster-location">{{item.location}}</text>
              <text class="poster-club">{{item.club}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>