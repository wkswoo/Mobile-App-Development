<!--index.wxml-->
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 打卡统计 -->
    <view class="stats-container">
      <view class="stat-item">
        <text class="stat-number">{{totalDays}}</text>
        <text class="stat-label">累计打卡天数</text>
      </view>
    </view>
    
    <!-- 打卡表单 -->
    <view class="form-container">
      <text class="form-title">今日学习打卡</text>
      <view class="form-item">
        <text class="form-label">学习了什么</text>
        <textarea class="form-input" placeholder="请输入学习内容" value="{{currentRecord.studyContent}}" bindinput="onStudyContentChange"></textarea>
      </view>
      <view class="form-item">
        <text class="form-label">收获如何</text>
        <textarea class="form-input" placeholder="请输入学习收获" value="{{currentRecord.harvest}}" bindinput="onHarvestChange"></textarea>
      </view>
      <button class="submit-btn" bindtap="submitRecord">提交打卡</button>
    </view>
    
    <!-- 打卡记录 -->
    <view class="records-container">
      <text class="records-title">打卡记录</text>
      <view wx:if="{{records.length === 0}}" class="no-records">
        <text>暂无打卡记录</text>
      </view>
      <view wx:else class="records-list">
        <view wx:for="{{records}}" wx:key="id" class="record-item">
          <view class="record-header">
            <text class="record-date">{{item.date}}</text>
            <button class="delete-btn" bindtap="deleteRecord" data-id="{{item.id}}">删除</button>
          </view>
          <view class="record-content">
            <text class="content-label">学习内容：</text>
            <text class="content-text">{{item.studyContent}}</text>
          </view>
          <view class="record-harvest">
            <text class="content-label">收获：</text>
            <text class="content-text">{{item.harvest}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
