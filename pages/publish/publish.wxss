/* publish.wxss */

.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.form-item {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.label {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #333333;
}

/* 图片上传样式 */
.image-upload {
  margin-top: 10rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.image-item {
  width: 160rpx;
  height: 160rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.7);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 40rpx;
}

.add-image {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #dddddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #999999;
}

.hint {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 输入框样式 */
.input {
  border: 2rpx solid #eeeeee;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 分类选择器样式 */
.category-picker {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.category-item {
  flex: 1;
  padding: 16rpx;
  border: 2rpx solid #eeeeee;
  border-radius: 8rpx;
  text-align: center;
  font-size: 32rpx;
  color: #666666;
}

.category-item.active {
  border-color: #007aff;
  color: #007aff;
  background-color: rgba(0, 122, 255, 0.1);
}

/* 提交按钮样式 */
.submit-btn {
  background-color: #007aff;
  color: #ffffff;
  font-size: 36rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.submit-btn::after {
  border: none;
}